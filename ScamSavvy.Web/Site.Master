<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content="Scam Savvy helps Malaysians recognise, avoid and report online scams." />
    <title>Scam Savvy</title>
    <link rel="icon" type="image/svg+xml" href="~/Images/logo.svg" runat="server" />
    <%-- External CSS: Bootstrap first, then the shared site stylesheet --%>
    <link rel="stylesheet" href="~/Styles/bootstrap.min.css" runat="server" />
    <link rel="stylesheet" href="~/Styles/site.css" runat="server" />
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>
<body>
    <a class="visually-hidden-focusable site-skip" href="#main">Skip to main content</a>

    <form id="form1" runat="server">

        <header>
            <nav class="navbar navbar-expand-xl navbar-dark site-navbar" aria-label="Main navigation">
                <div class="container">
                    <asp:HyperLink ID="lnkBrand" runat="server" NavigateUrl="~/Default.aspx" CssClass="navbar-brand d-flex align-items-center gap-2">
                        <asp:Image ID="imgLogo" runat="server" ImageUrl="~/Images/logo.svg" AlternateText="" Width="34" Height="34" />
                        <span>Scam <strong>Savvy</strong></span>
                    </asp:HyperLink>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#siteNav"
                        aria-controls="siteNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="siteNav">
                        <asp:Panel ID="pnlNav" runat="server" CssClass="d-xl-flex w-100 align-items-center">

                            <%-- Everyone --%>
                            <ul class="navbar-nav me-auto">
                                <li class="nav-item"><asp:HyperLink ID="lnkHome" runat="server" NavigateUrl="~/Default.aspx" CssClass="nav-link">Home</asp:HyperLink></li>
                                <li class="nav-item"><asp:HyperLink ID="lnkLessons" runat="server" NavigateUrl="~/Lessons.aspx" CssClass="nav-link">Lessons</asp:HyperLink></li>
                                <li class="nav-item"><asp:HyperLink ID="lnkQuizzes" runat="server" NavigateUrl="~/Quizzes.aspx" CssClass="nav-link">Quizzes</asp:HyperLink></li>
                                <li class="nav-item"><asp:HyperLink ID="lnkRepository" runat="server" NavigateUrl="~/ScamRepository.aspx" CssClass="nav-link">Scam Repository</asp:HyperLink></li>
                                <li class="nav-item"><asp:HyperLink ID="lnkChecker" runat="server" NavigateUrl="~/ScamChecker.aspx" CssClass="nav-link">Scam Checker</asp:HyperLink></li>

                                <%-- Logged in --%>
                                <asp:PlaceHolder ID="phMemberLinks" runat="server" Visible="false">
                                    <li class="nav-item"><asp:HyperLink ID="lnkSpot" runat="server" NavigateUrl="~/Member/SpotTheScam.aspx" CssClass="nav-link">Spot the Scam</asp:HyperLink></li>
                                    <li class="nav-item"><asp:HyperLink ID="lnkReport" runat="server" NavigateUrl="~/Member/ReportScam.aspx" CssClass="nav-link">Report a Scam</asp:HyperLink></li>
                                </asp:PlaceHolder>
                            </ul>

                            <ul class="navbar-nav">
                                <%-- Admin only --%>
                                <asp:PlaceHolder ID="phAdmin" runat="server" Visible="false">
                                    <li class="nav-item dropdown">
                                        <a id="adminMenu" class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminMenu">
                                            <li><asp:HyperLink ID="lnkAdminDashboard" runat="server" NavigateUrl="~/Admin/Dashboard.aspx" CssClass="dropdown-item">Dashboard</asp:HyperLink></li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li><asp:HyperLink ID="lnkAdminUsers" runat="server" NavigateUrl="~/Admin/ManageUsers.aspx" CssClass="dropdown-item">Users</asp:HyperLink></li>
                                            <li><asp:HyperLink ID="lnkAdminCategories" runat="server" NavigateUrl="~/Admin/ManageCategories.aspx" CssClass="dropdown-item">Categories</asp:HyperLink></li>
                                            <li><asp:HyperLink ID="lnkAdminLessons" runat="server" NavigateUrl="~/Admin/ManageLessons.aspx" CssClass="dropdown-item">Lessons</asp:HyperLink></li>
                                            <li><asp:HyperLink ID="lnkAdminQuizzes" runat="server" NavigateUrl="~/Admin/ManageQuizzes.aspx" CssClass="dropdown-item">Quizzes</asp:HyperLink></li>
                                            <li><asp:HyperLink ID="lnkAdminScenarios" runat="server" NavigateUrl="~/Admin/ManageScenarios.aspx" CssClass="dropdown-item">Scenarios</asp:HyperLink></li>
                                            <li><asp:HyperLink ID="lnkAdminReports" runat="server" NavigateUrl="~/Admin/ModerateReports.aspx" CssClass="dropdown-item">Reports</asp:HyperLink></li>
                                            <li><asp:HyperLink ID="lnkAdminFeedback" runat="server" NavigateUrl="~/Admin/ManageFeedback.aspx" CssClass="dropdown-item">Feedback</asp:HyperLink></li>
                                        </ul>
                                    </li>
                                </asp:PlaceHolder>

                                <%-- Logged in: personal links grouped under the user's name --%>
                                <asp:PlaceHolder ID="phLoggedIn" runat="server" Visible="false">
                                    <li class="nav-item dropdown">
                                        <a id="accountMenu" class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="site-avatar" aria-hidden="true"><asp:Literal ID="litInitial" runat="server" /></span>
                                            <asp:Literal ID="litUserName" runat="server" />
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountMenu">
                                            <li><asp:HyperLink ID="lnkMyProgress" runat="server" NavigateUrl="~/Member/MyProgress.aspx" CssClass="dropdown-item">My Progress</asp:HyperLink></li>
                                            <li><asp:HyperLink ID="lnkMyProfile" runat="server" NavigateUrl="~/Member/MyProfile.aspx" CssClass="dropdown-item">My Profile</asp:HyperLink></li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li><asp:LinkButton ID="btnLogout" runat="server" CssClass="dropdown-item" CausesValidation="false" OnClick="btnLogout_Click">Log out</asp:LinkButton></li>
                                        </ul>
                                    </li>
                                </asp:PlaceHolder>

                                <%-- Logged out --%>
                                <asp:PlaceHolder ID="phLoggedOut" runat="server">
                                    <li class="nav-item"><asp:HyperLink ID="lnkLogin" runat="server" NavigateUrl="~/Login.aspx" CssClass="nav-link">Log in</asp:HyperLink></li>
                                    <li class="nav-item"><asp:HyperLink ID="lnkRegister" runat="server" NavigateUrl="~/Register.aspx" CssClass="btn btn-warning btn-sm ms-xl-2 site-nav-cta">Register</asp:HyperLink></li>
                                </asp:PlaceHolder>
                            </ul>
                        </asp:Panel>
                    </div>
                </div>
            </nav>
        </header>

        <main id="main" class="site-main" tabindex="-1">
            <div class="container py-4">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </main>

        <footer class="site-footer">
            <div class="container">
                <div class="row g-4 align-items-center">
                    <div class="col-md-6">
                        <p class="site-footer-alert mb-1">
                            <span aria-hidden="true">&#9742;</span>
                            Been scammed? Call <a href="tel:997">997</a>
                        </p>
                        <p class="small mb-0">National Scam Response Centre (NSRC), open 24 hours. Call as soon as you notice money leaving your account.</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <p class="mb-1">
                            Check a phone number or bank account on
                            <a href="https://semakmule.rmp.gov.my/" target="_blank" rel="noopener noreferrer">Semak Mule (PDRM)</a>
                        </p>
                        <p class="small mb-1"><asp:HyperLink ID="lnkFeedback" runat="server" NavigateUrl="~/Feedback.aspx">Send us feedback</asp:HyperLink></p>
                        <p class="small mb-0">&copy; <asp:Literal ID="litYear" runat="server" /> Scam Savvy &middot; LAB-36 Group 07 &middot; Asia Pacific University</p>
                    </div>
                </div>
            </div>
        </footer>

    </form>

    <script src="<%: ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>"></script>
    <script src="<%: ResolveUrl("~/Scripts/site.js") %>"></script>
</body>
</html>
